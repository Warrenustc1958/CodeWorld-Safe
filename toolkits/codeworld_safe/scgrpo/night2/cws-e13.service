[Unit]
Description=CodeWorld-Safe SC-GRPO E13 grader cost, fixed eta 0.5 (10 steps, then eval 10) - /data_cf/cws_sam/v1/scgrpo/e13_pipeline.sh
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/data_cf/cws_sam/v1/scgrpo
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash /data_cf/cws_sam/v1/scgrpo/e13_pipeline.sh
Restart=on-failure
RestartSec=300
KillMode=process
StandardOutput=append:/data_cf/cws_sam/v1/scgrpo/causal/e13night/pipeline.log
StandardError=append:/data_cf/cws_sam/v1/scgrpo/causal/e13night/pipeline.log
