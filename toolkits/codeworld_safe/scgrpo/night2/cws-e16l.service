[Unit]
Description=CodeWorld-Safe C / E16-L: initial-state 256-step real-reward GRPO, 10 steps + eval - /data_cf/cws_sam/v1/scgrpo/e16l_pipeline.sh
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/data_cf/cws_sam/v1/scgrpo
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash /data_cf/cws_sam/v1/scgrpo/e16l_pipeline.sh
Restart=on-failure
RestartSec=300
KillMode=process
StandardOutput=append:/data_cf/cws_sam/v1/scgrpo/causal/e16lnight/pipeline.log
StandardError=append:/data_cf/cws_sam/v1/scgrpo/causal/e16lnight/pipeline.log
